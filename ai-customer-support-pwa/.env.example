# ============================================
# AI CUSTOMER SUPPORT PWA - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# REQUIRED - Supabase Configuration
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ============================================
# REQUIRED - Anthropic AI Configuration  
# ============================================
# Get this from: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ============================================
# REQUIRED - App Configuration
# ============================================
# Your deployed Vercel URL (update after first deploy)

VITE_APP_URL=https://your-app.vercel.app

# ============================================
# OPTIONAL - Stripe Payments
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key

# ============================================
# OPTIONAL - PostHog Analytics
# ============================================
# Get this from: https://app.posthog.com/project/settings

VITE_POSTHOG_KEY=phc_your-posthog-key
VITE_POSTHOG_HOST=https://app.posthog.com

# ============================================
# OPTIONAL - Email (for notifications)
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
